# ─────────────────────────────────────────────────────────
# LRR Backend (NestJS) — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
#
# For staging/prod: secrets are stored in AWS Secrets Manager.
# NODE_ENV is set in the ECS task definition (not in Secrets Manager).
# ─────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────
# development | staging | production
# Local: set to development
# Staging/prod: set in ECS task definition (overrides Dockerfile default)
NODE_ENV=development

# App
PORT=3000

# Database (PostgreSQL)
# Local:   postgresql://user:password@localhost:5432/lrr_db?schema=public
# Neon:    postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/lrr_db?schema=public

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=change-this-to-a-long-random-secret

# ── Twilio ────────────────────────────────────────────────
# Use Twilio subaccounts per environment (LRR Stage / LRR Prod)
# Staging: sandbox WhatsApp number (+14155238886) or staging sender
# Prod:    approved WhatsApp Business number
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=+14155238886

# ── Paystack ──────────────────────────────────────────────
# Staging: sk_test_...  (no real money)
# Prod:    sk_live_...  (real NGN transactions)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Frontend URL (used for Paystack callback_url after checkout) ───────────
# Local:   http://localhost:3001
# Staging: https://staging.lrr.ninelm.com
# Prod:    https://lrr.ninelm.com
FRONTEND_URL=http://localhost:3001

# ── Sentry (error tracking) ────────────────────────────────────────────────
# Get DSN from: sentry.io → lrr-service project → Settings → Client Keys
# Environment label in Sentry comes from NODE_ENV above.
SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
