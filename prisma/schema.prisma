generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============== ENUMS ==============

enum SubscriptionPlan {
  INDIVIDUAL
  COMMERCIAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum DispatchOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  TIMED_OUT
}

enum UserRole {
  CUSTOMER
  OPERATOR
  ADMIN
  SUPER_ADMIN
}

enum OperatorMemberRole {
  OWNER
  MANAGER
  DISPATCHER
  DRIVER
  STAFF
}

enum OperatorType {
  TOW_TRUCK
  MECHANIC
  FUEL_DELIVERY
  TYRE_REPAIR
  BATTERY_JUMPSTART
}

enum OperatorStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RescueRequestStatus {
  WAITING_FOR_LOCATION
  WAITING_FOR_ISSUE_TYPE
  WAITING_FOR_MEDIA
  WAITING_FOR_DEPOSIT
  DISPATCHING
  OPERATOR_ASSIGNED
  IN_PROGRESS
  ARRIVED
  COMPLETED
  CANCELLED
  STALLED
}

enum IssueType {
  BREAKDOWN
  ACCIDENT
  FLAT_TYRE
  FUEL
}

enum TruckClass {
  LIGHT_DUTY
  TEN_TYRE
  LOW_BED
  HIAB
}

enum VehicleType {
  SEDAN
  SUV
  ARMORED_LUXURY
  HEAVY_TRAILER
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

// ============== MODELS ==============

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  phoneNumber  String?   @unique
  passwordHash String?
  name         String?
  role         UserRole

  operatorMemberships OperatorMember[]
  rescueRequests      RescueRequest[]
  subscriptions       Subscription[]
  whatsAppSession     WhatsAppSession?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([phoneNumber])
}

model Operator {
  id            String         @id @default(cuid())

  type          OperatorType   @default(TOW_TRUCK)
  truckClasses  TruckClass[]   @default([])

  businessName  String
  contactName   String
  phoneNumber   String         @unique
  email         String?

  address       String
  latitude      Decimal
  longitude     Decimal

  serviceRadius Int            @default(10)
  status        OperatorStatus @default(PENDING)
  isAvailable   Boolean        @default(true)

  verifiedAt    DateTime?
  notes         String?

  members        OperatorMember[]
  rescueRequests RescueRequest[]
  dispatchOffers DispatchOffer[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([type])
  @@index([latitude, longitude])
}

model OperatorMember {
  id         String              @id @default(cuid())

  userId     String
  user       User                @relation(fields: [userId], references: [id])

  operatorId String
  operator   Operator            @relation(fields: [operatorId], references: [id])

  role       OperatorMemberRole  @default(STAFF)

  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([userId, operatorId])
  @@index([operatorId])
  @@index([userId])
  @@index([role])
}

model RescueRequest {
  id                 String              @id @default(cuid())
  
  customerId         String
  customer           User                @relation(fields: [customerId], references: [id])

  status             RescueRequestStatus @default(WAITING_FOR_LOCATION)

  latitude           Decimal?
  longitude          Decimal?

  issueType          IssueType?
  vehicleType        VehicleType?
  destination        String?

  depositPaid        Boolean             @default(false)
  depositAmount      Int?
  depositReference   String?
  balancePaid        Boolean             @default(false)
  balanceAmount      Int?
  balanceReference   String?

  assignedOperatorId String?
  assignedOperator   Operator?           @relation(fields: [assignedOperatorId], references: [id])

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  dispatchOffers     DispatchOffer[]
  media              RequestMedia[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([depositReference])
  @@index([balanceReference])
}

// Photos/video/audio submitted by the motorist for a request, forwarded
// to operators as signed redirect links in the dispatch offer.
model RequestMedia {
  id               String        @id @default(cuid())

  rescueRequestId  String
  rescueRequest    RescueRequest @relation(fields: [rescueRequestId], references: [id])

  mediaType        MediaType
  s3Key            String
  contentType      String

  createdAt        DateTime      @default(now())

  @@index([rescueRequestId])
}

// Tracks each operator offer during dispatch (accept/decline/timeout)
model DispatchOffer {
  id               String              @id @default(cuid())

  rescueRequestId  String
  rescueRequest    RescueRequest       @relation(fields: [rescueRequestId], references: [id])

  operatorId       String
  operator         Operator            @relation(fields: [operatorId], references: [id])

  status           DispatchOfferStatus @default(PENDING)
  offeredAt        DateTime            @default(now())
  respondedAt      DateTime?
  expiresAt        DateTime

  @@index([rescueRequestId])
  @@index([operatorId])
  @@index([status])
}

// WhatsApp conversation sessions (DB-backed, survives restarts)
// One session per User — userId is the primary lookup key.
// Twilio gives us a phone number on every inbound message; we always
// resolve it to a User (creating one if needed) before touching this table.
model WhatsAppSession {
  id      String @id @default(cuid())

  // Every session belongs to exactly one User (created on first SOS if unregistered).
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id])

  // Flow state (matches WhatsAppFlowState enum)
  state   String @default("IDLE")

  // Location captured during flow
  latitude    Decimal?
  longitude   Decimal?

  // Issue selected
  issueType   String?
  vehicleType String?
  destination String?

  // Linked rescue request once created
  rescueRequestId String?

  // Payment reference (deposit)
  depositReference String?

  // Dispatch tracking
  dispatchRound      Int    @default(0)
  offeredOperatorIds String @default("[]") // JSON array of operator IDs already tried

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Customer subscriptions (Individual or Commercial/Fleet)
model Subscription {
  id               String             @id @default(cuid())

  userId           String
  user             User               @relation(fields: [userId], references: [id])

  plan             SubscriptionPlan
  status           SubscriptionStatus @default(ACTIVE)

  // Billing
  paystackCustomerCode String?
  paystackSubscriptionCode String?
  monthlyAmountKobo    Int            // e.g. 300000 for ₦3,000

  // Tow allowance
  towsIncludedPerMonth Int            @default(2)
  towsUsedThisMonth    Int            @default(0)

  // Period
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime

  // For fleet — optional vehicle identifier
  vehicleRef           String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
}