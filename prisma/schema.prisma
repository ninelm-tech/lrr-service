generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============== ENUMS ==============

enum SubscriptionPlan {
  INDIVIDUAL
  COMMERCIAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum DispatchOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  TIMED_OUT
}

enum UserRole {
  CUSTOMER
  OPERATOR
  ADMIN
  SUPER_ADMIN
}

enum OperatorMemberRole {
  OWNER
  MANAGER
  DISPATCHER
  DRIVER
  STAFF
}

enum OperatorType {
  TOW_TRUCK
  MECHANIC
  FUEL_DELIVERY
  TYRE_REPAIR
  BATTERY_JUMPSTART
}

enum OperatorStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RescueRequestStatus {
  WAITING_FOR_LOCATION
  WAITING_FOR_ISSUE_TYPE
  WAITING_FOR_DEPOSIT
  DISPATCHING
  OPERATOR_ASSIGNED
  IN_PROGRESS
  ARRIVED
  COMPLETED
  CANCELLED
  STALLED
}

enum IssueType {
  BREAKDOWN
  ACCIDENT
  FLAT_TYRE
  FUEL
}

// ============== MODELS ==============

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  phoneNumber  String?   @unique
  passwordHash String?
  name         String?
  role         UserRole

  operatorMemberships OperatorMember[]
  rescueRequests      RescueRequest[]
  subscriptions       Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([phoneNumber])
}

model Operator {
  id            String         @id @default(cuid())

  type          OperatorType   @default(TOW_TRUCK)

  businessName  String
  contactName   String
  phoneNumber   String         @unique
  email         String?

  address       String
  latitude      Decimal
  longitude     Decimal

  serviceRadius Int            @default(10)
  status        OperatorStatus @default(PENDING)
  isAvailable   Boolean        @default(true)

  verifiedAt    DateTime?
  notes         String?

  members        OperatorMember[]
  rescueRequests RescueRequest[]
  dispatchOffers DispatchOffer[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([type])
  @@index([latitude, longitude])
}

model OperatorMember {
  id         String              @id @default(cuid())

  userId     String
  user       User                @relation(fields: [userId], references: [id])

  operatorId String
  operator   Operator            @relation(fields: [operatorId], references: [id])

  role       OperatorMemberRole  @default(STAFF)

  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([userId, operatorId])
  @@index([operatorId])
  @@index([userId])
  @@index([role])
}

model RescueRequest {
  id                 String              @id @default(cuid())
  
  customerId         String
  customer           User                @relation(fields: [customerId], references: [id])

  status             RescueRequestStatus @default(WAITING_FOR_LOCATION)

  latitude           Decimal?
  longitude          Decimal?

  issueType          IssueType?

  depositPaid        Boolean             @default(false)
  depositAmount      Int?
  depositReference   String?
  balancePaid        Boolean             @default(false)
  balanceAmount      Int?
  balanceReference   String?

  assignedOperatorId String?
  assignedOperator   Operator?           @relation(fields: [assignedOperatorId], references: [id])

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  dispatchOffers     DispatchOffer[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([depositReference])
  @@index([balanceReference])
}

// Tracks each operator offer during dispatch (accept/decline/timeout)
model DispatchOffer {
  id               String              @id @default(cuid())

  rescueRequestId  String
  rescueRequest    RescueRequest       @relation(fields: [rescueRequestId], references: [id])

  operatorId       String
  operator         Operator            @relation(fields: [operatorId], references: [id])

  status           DispatchOfferStatus @default(PENDING)
  offeredAt        DateTime            @default(now())
  respondedAt      DateTime?
  expiresAt        DateTime

  @@index([rescueRequestId])
  @@index([operatorId])
  @@index([status])
}

// WhatsApp conversation sessions (DB-backed, survives restarts)
model WhatsAppSession {
  id              String   @id @default(cuid())
  phoneNumber     String   @unique

  // Flow state (matches WhatsAppFlowState enum)
  state           String   @default("IDLE")

  // Location captured during flow
  latitude        Decimal?
  longitude       Decimal?

  // Issue selected
  issueType       String?

  // Linked rescue request once created
  rescueRequestId String?

  // Payment reference (deposit)
  depositReference String?

  // Dispatch tracking: current round and operators already offered
  dispatchRound   Int      @default(0)
  offeredOperatorIds String @default("[]") // JSON array of operator IDs already offered in this cycle

  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([phoneNumber])
}

// Customer subscriptions (Individual or Commercial/Fleet)
model Subscription {
  id               String             @id @default(cuid())

  userId           String
  user             User               @relation(fields: [userId], references: [id])

  plan             SubscriptionPlan
  status           SubscriptionStatus @default(ACTIVE)

  // Billing
  paystackCustomerCode String?
  paystackSubscriptionCode String?
  monthlyAmountKobo    Int            // e.g. 300000 for ₦3,000

  // Tow allowance
  towsIncludedPerMonth Int            @default(2)
  towsUsedThisMonth    Int            @default(0)

  // Period
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime

  // For fleet — optional vehicle identifier
  vehicleRef           String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
}